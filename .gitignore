# ClassroomOS .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
*.whl

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Ruff cache
.ruff_cache/

# Runtime data (generated by the app)
console/data/config.json
console/data/audit_log.csv
console/data/console.log
agent/agent.log

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# PyInstaller
*.spec
